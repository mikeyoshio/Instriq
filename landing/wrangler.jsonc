{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "instriq",
  "main": "agent-worker.js",
  // Genera /es/ i /en/ a partir de index.html abans de cada deploy.
  "build": { "command": "node build-langs.mjs" },
  "compatibility_date": "2026-07-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
